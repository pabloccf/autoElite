{% extends 'base.html.twig' %}

{% block title %}Usuarios{% endblock %}

{% block body %}
    {{ parent() }}
    <div class="container well">
        <div class="col-md-9">
            <h2>{{ user.name }} {{ user.surname }}</h2>
            <br>
            <dl>
                <dt>{{'Usuario'}}</dt>
                <dd>
                    {{ user.username }}
                    &nbsp;
                </dd>
                <br>
                <dt>{{ 'Nombre' }}</dt>
                <dd>
                    {{ user.name }}
                    &nbsp;
                </dd>
                <br>
                <dt>{{ 'Apellidos' }}</dt>
                <dd>
                    {{ user.surname }}
                    &nbsp;
                </dd>
                <br>
                <dt>{{ 'Email' }}</dt>
                <dd>
                    {{ user.email }}
                    &nbsp;
                </dd>
                <br>
                <dt>{{'Tel&eacute;fono'}}</dt>
                <dd>
                    {{ user.telephone }}
                    &nbsp;
                </dd>
                <br>
                <dt>{{ 'Rol' }}</dt>
                <dd>
                    {% if 'ROLE_ADMIN' in user.roles %}
                        <strong>Administrador</strong>
                    {% elseif 'ROLE_USER' in user.roles %}
                        <strong>Usuario</strong>
                    {% endif %}
                    &nbsp;
                </dd>
                <br>
            </dl>
        </div>
        {#<div class="col-md-3">
            <h3>{{'Actions'}}:</h3>
            <p>
                <a href="{{ path('user_edit', { id : user.id}) }}" class="btn btn-primary btn-lg btn-block">
                    <span class="glyphicon glyphicon-edit"></span>
                    {{ 'Edit user' }}
                </a>
            </p>
            <p>
                {{ include('UserBundle:User:forms/form.html.twig', { form: delete_form, message : 'Are you sure?' }) }}
            </p>
        </div>#}
    </div>
{% endblock %}