<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" type="image/png" href="{{ asset('images/favicon.webp') }}">
        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
            <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
        {% endblock %}
    </head>
    <body>
        {% block body %}
            <style>
                body {
                    background-color: white;
                }

                .gradient-button {
                    background: rgb(34,182,195);
                    background: linear-gradient(90deg, rgba(34,182,195,1) 0%, rgba(57,193,16,1) 100%);
                    background: -webkit-linear-gradient(90deg, rgba(34,182,195,1) 0%, rgba(57,193,16,1) 100%);
                    color: white;
                    font-weight: bold;
                }

                .dealer-wallpaper {
                    background-image: url("{{ asset('images/fondoConcesionario.jpg') }}");
                    background-size: cover;
                    background-position: center;
                    background-repeat: no-repeat;
                    display: flex;
                    justify-content: center;
                    text-align: center;
                    width: 100%;
                    height: 100vh;
                }

                /* La clase table-container, ajustada con media queries para pantallas pequeñas */
                .table-container {
                    background-color: rgba(255, 255, 255, 0.8);
                    border-radius: 10px;
                    padding: 20px;
                    padding-top: 0px;
                    margin: 20px auto; /* Centrar en pantallas pequeñas */
                    width: 80%; /* Porcentaje relativo para adaptarse */
                    max-width: 1200px; /* Limita el tamaño máximo en pantallas grandes */
                    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.1);
                }
            </style>

            {% if app.request.attributes.get('_route') != 'app_login' and
                app.request.attributes.get('_route') != 'app_register' and
                app.request.attributes.get('_route') != 'edit_user' and
                app.request.attributes.get('_route') != 'add_car' and
                app.request.attributes.get('_route') != 'add_car_model' and
                app.request.attributes.get('_route') != 'add_car_brand' and
                app.request.attributes.get('_route') != 'edit_car' and
                app.request.attributes.get('_route') != 'edit_car_model' and
                app.request.attributes.get('_route') != 'edit_car_brand' and
                app.request.attributes.get('_route') != 'add_sale'
            %}
                    {% include 'navbar.html.twig'%}
            {% endif %}
        {% endblock %}
    </body>
</html>
