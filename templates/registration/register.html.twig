{% extends 'base.html.twig' %}

{% block title %}Registro{% endblock %}

{% block body %}
    {{ parent() }}

    <section class="vh-100" style="background-color: #eee;">
        <div class="container h-100">
            <div class="row d-flex justify-content-center align-items-center h-100">
                <div class="col-lg-12 col-xl-11">
                    <div class="card text-black" style="border-radius: 25px;">
                        <div class="card-body p-md-5">
                            <div class="row justify-content-center">
                                <div class="col-md-10 col-lg-6 col-xl-5 order-2 order-lg-1">

                                    <p class="text-center h1 fw-bold mb-4 mx-1 mx-md-4 mt-4">Crear cuenta</p>
                                    <nav aria-label="breadcrumb">
                                        <ol class="breadcrumb">
                                            <li class="breadcrumb-item">
                                                <a href="{{ path('list_user') }}">Volver</a>
                                            </li>
                                            <li class="breadcrumb-item active" aria-current="page">Crear cuenta</li>
                                        </ol>
                                    </nav>

                                    {{ form_start(registrationForm) }}
                                    <div class="mx-1 mx-md-4">
                                        <div class="d-flex flex-row align-items-center mb-4">
                                            <i class="fas fa-user fa-lg me-3 fa-fw"></i>
                                            <div data-mdb-input-init class="form-outline flex-fill mb-0">
                                                {{ form_widget(registrationForm.name) }}
                                                <small class="form-text text-danger">{{ form_errors(registrationForm.name) }}</small>
                                            </div>
                                        </div>

                                        <div class="d-flex flex-row align-items-center mb-4">
                                            <i class="fas fa-user fa-lg me-3 fa-fw"></i>
                                            <div data-mdb-input-init class="form-outline flex-fill mb-0">
                                                {{ form_widget(registrationForm.surname) }}
                                                <small class="form-text text-danger">{{ form_errors(registrationForm.surname) }}</small>
                                            </div>
                                        </div>

                                        <div class="d-flex flex-row align-items-center mb-4">
                                            <i class="fas fa-phone fa-lg me-3 fa-fw"></i>
                                            <div data-mdb-input-init class="form-outline flex-fill mb-0">
                                                {{ form_widget(registrationForm.telephone) }}
                                                <small class="form-text text-danger">{{ form_errors(registrationForm.telephone) }}</small>
                                            </div>
                                        </div>

                                        <div class="d-flex flex-row align-items-center mb-4">
                                            <i class="fas fa-address-book fa-lg me-3 fa-fw"></i>
                                            <div data-mdb-input-init class="form-outline flex-fill mb-0">
                                                {{ form_widget(registrationForm.username) }}
                                                <small class="form-text text-danger">{{ form_errors(registrationForm.username) }}</small>
                                            </div>
                                        </div>

                                        <div class="d-flex flex-row align-items-center mb-4">
                                            <i class="fas fa-envelope fa-lg me-3 fa-fw"></i>
                                            <div data-mdb-input-init class="form-outline flex-fill mb-0">
                                                {{ form_widget(registrationForm.email) }}
                                                <small class="form-text text-danger">{{ form_errors(registrationForm.email) }}</small>
                                            </div>
                                        </div>

                                        <div class="d-flex flex-row align-items-center mb-4">
                                            <i class="fas fa-lock fa-lg me-3 fa-fw"></i>
                                            <div data-mdb-input-init class="form-outline flex-fill mb-0">
                                                {{ form_widget(registrationForm.plainPassword) }}
                                                <small class="form-text text-danger">{{ form_errors(registrationForm.plainPassword) }}</small>
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-center mx-4 mb-3 mb-lg-4">
                                            {{ form_widget(registrationForm.send, { 'label': 'Crear Cuenta' }) }}
                                        </div>
                                    </div>
                                    {{ form_end(registrationForm) }}
                                </div>
                                <div class="col-md-10 col-lg-6 col-xl-7 d-flex align-items-center order-1 order-lg-2 justify-content-center">
                                    <img src="{{asset('images/autoElite_logo.png')}}" class="img-fluid" alt="AutoElite logo" width="60%">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
