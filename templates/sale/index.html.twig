{% extends 'base.html.twig' %}

{% block title %}Ventas{% endblock %}

{% block body %}
    {{ parent() }}

    <div class="container-fluid dealer-wallpaper">
        <div class="col-md-12 table-container">
            <div class="pt-5 pb-3 d-flex">
                <h2 class="ms-5" style="text-align: left"><strong>Ventas</strong></h2>
            </div>
            <div class="table-responsive d-flex align-items-center">
                {#<table class="table table-hover">
                    <thead class="table-light">
                    <tr>
                        <th>Imagen</th>
                        <th>Marca</th>
                        <th>Modelo</th>
                        <th>Matr&iacute;cula</th>
                        <th>Año de fabricaci&oacute;n</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for car in cars %}
                        <tr data-id="{{ car.id }}">
                            <td>
                                <img src="{{ asset('uploads/models/' ~ car.model_image) }}" alt="{{ car.model_name }} logo" style="width: auto; height: 60px;">
                            </td>
                            <td>{{ car.brand_name }}</td>
                            <td>{{ car.model_name }}</td>
                            <td>{{ car.plate }}</td>
                            <td>{{ car.manufacture_year }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>#}
            </div>
            {# display navigation #}
            {#<div class="navigation">
                {{ knp_pagination_render(cars) }}
            </div>#}
        </div>
    </div>
{% endblock %}

