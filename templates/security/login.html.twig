{% extends 'base.html.twig' %}

{% block title %}Inicio de sesi&oacute;n{% endblock %}

{% block body %}
    {#<form method="post">
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div class="mb-3">
                You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
            </div>
        {% endif %}

        <h1 class="h3 mb-3 font-weight-normal">Please sign in</h1>
        <label for="username">Email</label>
        <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
        <label for="password">Password</label>
        <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>

        <input type="hidden" name="_csrf_token"
               value="{{ csrf_token('authenticate') }}"
        >

        #}{#
            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
            See https://symfony.com/doc/current/security/remember_me.html

            <div class="checkbox mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Remember me</label>
            </div>
        #}{#

        <button class="btn btn-lg btn-primary" type="submit">
            Sign in
        </button>
    </form>#}

    <style>
        .gradient-custom-2 {
            background: rgb(34,182,195);
            background: linear-gradient(90deg, rgba(34,182,195,1) 0%, rgba(57,193,16,1) 100%);
            background: -webkit-linear-gradient(90deg, rgba(34,182,195,1) 0%, rgba(57,193,16,1) 100%);
        }

        img {
            max-width: 100%;
            height: auto;
        }

        form {
            width: 100%;
        }

        input[type="email"], input[type="password"] {
            width: 100%;
            padding: 0.5rem;
            margin-bottom: 1rem;
            box-sizing: border-box;
        }

        .container {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        @media (min-width: 768px) {
            .gradient-form {
                height: 100vh !important;
            }

            .container {
                flex-direction: row;
                justify-content: center;
            }

            .row {
                flex-direction: row;
            }
        }

        @media (min-width: 769px) {
            .gradient-custom-2 {
                border-top-right-radius: .3rem;
                border-bottom-right-radius: .3rem;
            }
        }

        @media (max-width: 767px) {
            .card {
                margin: 0 1rem;
            }

            .gradient-custom-2 {
                border-radius: 0;
            }
        }
    </style>

    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    {% if app.user %}
        <div class="mb-3">
            You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
        </div>
    {% endif %}

    <section class="h-100 gradient-form" style="background-color: #eee;">
        <div class="container h-100">
            <div class="row d-flex justify-content-center align-items-center h-100">
                <div class="col-xl-10">
                    <div class="card rounded-3 text-black">
                        <div class="row g-0">
                            <div class="col-lg-6">
                                <div class="card-body p-md-5 mx-md-4">

                                    <div class="text-center">
                                        <img src="{{asset('images/autoElite_logo.png')}}" style="width: 185px;" alt="AutoElite logo">
                                        <h4 class="mt-1 mb-5 pb-1" style="padding-top: 1em;">Somos el equipo de AutoElite</h4>
                                    </div>

                                    <div>
                                        <p>Por favor inicia sesi&oacute;n en tu cuenta</p>

                                        <div class="d-flex flex-row align-items-center mb-2">
                                            <i class="fas fa-envelope fa-lg me-3 fa-fw"></i>
                                            <div data-mdb-input-init class="form-outline flex-fill mb-0">
                                                <input type="email" id="email" class="form-control requiredField" placeholder="Email"/>
                                                <small></small>
                                            </div>
                                        </div>

                                        <div data-mdb-input-init class="d-flex flex-row align-items-center mb-2">
                                            <i class="fas fa-lock fa-lg me-3 fa-fw"></i>
                                            <div data-mdb-input-init class="form-outline flex-fill mb-0">
                                                <input type="password" id="password" class="form-control requiredField" placeholder="Contraseña" />
                                                <small></small>
                                            </div>
                                        </div>

                                        <div class="text-center pt-1 mb-5 pb-1">
                                            <button data-mdb-button-init data-mdb-ripple-init class="btn btn-primary btn-block gradient-custom-2 mb-3 btn-form" type="submit" style="border: none;"><strong>Iniciar sesi&oacute;n</strong></button>
                                            <a class="text-muted" href="#!" style="margin-left: .5em;">¿Se te ha olvidado la contraseña?</a>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="col-lg-6 d-flex align-items-center gradient-custom-2">
                                <div class="text-white px-3 py-4 p-md-5 mx-md-4">
                                    <h4 class="mb-4">Somos m&aacute;s que una empresa</h4>
                                    <p class="small mb-0">Nos complace darle la bienvenida a AutoElite, su plataforma integral de gestión para concesionarios multimarca. Este sistema ha sido diseñado para optimizar y simplificar todos los aspectos de la gestión de su concesionario, la administración de inventarios y ventas.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
